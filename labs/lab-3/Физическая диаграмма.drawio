<mxfile host="app.diagrams.net"><diagram name="Физическая диаграмма" id="fizicheskaya_diagramma"><mxGraphModel dx="1060" dy="450" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1060" pageHeight="450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Парикмахерская&lt;br&gt;(основной салон и филиал)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="260" height="70" as="geometry"/></mxCell><mxCell id="n3" value="Новые клиенты" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="75.0" y="330" width="30" height="60" as="geometry"/></mxCell><mxCell id="n4" value="Пользуются услугами,&lt;br&gt;оплачивают стрижки&lt;br&gt;по полной стоимости" style="endArrow=none;html=1;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n2" target="n3"><mxGeometry x="0.4" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n5" value="Постоянные клиенты" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="285.0" y="330" width="30" height="60" as="geometry"/></mxCell><mxCell id="n6" value="Пользуются услугами,&lt;br&gt;получают скидку 3 %" style="endArrow=none;html=1;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n2" target="n5"><mxGeometry x="-0.2" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n7" value="Поставщики косметики&lt;br&gt;и расходных материалов" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="515.0" y="330" width="30" height="60" as="geometry"/></mxCell><mxCell id="n8" value="Поставляют косметику&lt;br&gt;и ра